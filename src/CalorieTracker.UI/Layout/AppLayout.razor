@inherits LayoutComponentBase
@inject IUserProfileRepository ProfileRepo
@inject IThemeService ThemeService
@inject IAppUpdateService AppUpdate
@implements IDisposable

<div class="ct-shell">
    @Body

    @if (AppUpdate.IsUpdateAvailable && !_updateDismissed)
    {
        <div class="ct-update-banner" role="status" aria-live="polite">
            <div style="display:flex; align-items:center; gap:8px; min-width:0;">
                <span style="color:var(--ct-green);"><AppIcon Name="@AppIcons.Refresh" Size="18" /></span>
                <div style="min-width:0;">
                    <div style="font-weight:700; font-size:0.86rem;">Update ready</div>
                    <div class="ct-muted" style="font-size:0.75rem;">A newer version is ready to install</div>
                </div>
            </div>
            <div style="display:flex; align-items:center; gap:4px; flex-shrink:0;">
                <button class="ct-btn ct-btn-primary ct-btn-sm" @onclick="ApplyUpdateAsync">Update</button>
                <button class="ct-icon-btn" title="Dismiss" @onclick="() => _updateDismissed = true"><AppIcon Name="@AppIcons.Close" Size="16" /></button>
            </div>
        </div>
    }

    <nav class="ct-bottom-nav" aria-label="Main navigation">
        <NavLink class="ct-nav-item" href="" Match="NavLinkMatch.All">
            <span class="ct-nav-icon"><AppIcon Name="@AppIcons.Diary" Size="20" /></span>
            <span>Diary</span>
        </NavLink>
        <NavLink class="ct-nav-item" href="foods">
            <span class="ct-nav-icon"><AppIcon Name="@AppIcons.Foods" Size="20" /></span>
            <span>Foods</span>
        </NavLink>
        <NavLink class="ct-nav-item" href="progress">
            <span class="ct-nav-icon"><AppIcon Name="@AppIcons.Progress" Size="20" /></span>
            <span>Progress</span>
        </NavLink>
    </nav>
</div>

@code {
    private bool _updateDismissed;

    protected override async Task OnInitializedAsync()
    {
        AppUpdate.UpdateAvailableChanged += HandleUpdateAvailable;
        try
        {
            var profile = await ProfileRepo.GetOrCreateAsync();
            await ThemeService.ApplyThemeAsync(profile.ThemeMode, profile.ColorScheme);
        }
        catch
        {
            // ignore theme sync errors during early init
        }

        await AppUpdate.StartWatchingAsync();
    }

    private void HandleUpdateAvailable()
    {
        _updateDismissed = false;
        InvokeAsync(StateHasChanged);
    }

    private Task ApplyUpdateAsync() => AppUpdate.ApplyUpdateAsync();

    public void Dispose()
    {
        AppUpdate.UpdateAvailableChanged -= HandleUpdateAvailable;
    }
}

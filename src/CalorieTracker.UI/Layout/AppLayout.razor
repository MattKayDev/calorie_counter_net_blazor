@inherits LayoutComponentBase
@inject IUserProfileRepository ProfileRepo
@inject IThemeService ThemeService

<div class="ct-shell">
    @Body

    <nav class="ct-bottom-nav" aria-label="Main navigation">
        <NavLink class="ct-nav-item" href="" Match="NavLinkMatch.All">
            <span class="ct-nav-icon">📓</span>
            <span>Diary</span>
        </NavLink>
        <NavLink class="ct-nav-item" href="foods">
            <span class="ct-nav-icon">🥗</span>
            <span>Foods</span>
        </NavLink>
        <NavLink class="ct-nav-item" href="progress">
            <span class="ct-nav-icon">📈</span>
            <span>Progress</span>
        </NavLink>
    </nav>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profile = await ProfileRepo.GetOrCreateAsync();
            await ThemeService.ApplyThemeAsync(profile.ThemeMode, profile.ColorScheme);
        }
        catch
        {
            // ignore theme sync errors during early init
        }
    }
}

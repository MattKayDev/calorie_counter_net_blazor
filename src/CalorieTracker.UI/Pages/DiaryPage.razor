@page "/"
@using System.Globalization
@inject IUserProfileRepository ProfileRepo
@inject IMealSlotRepository SlotRepo
@inject IFoodLogRepository LogRepo
@inject IWaterLogRepository WaterRepo
@inject DiaryService Diary

<div class="ct-diary-layout">
<div class="ct-topbar">
    <div class="ct-topbar-row">
        <div class="ct-topbar-left">
            <a class="ct-cog-btn" href="settings" title="Settings" aria-label="Settings"><AppIcon Name="@AppIcons.Settings" Size="20" /></a>
            <div class="ct-brand">Calorie Diary</div>
        </div>
        <button class="ct-cog-btn" title="History" aria-label="History"
                @onclick="() => _calendarOpen = true">
            <AppIcon Name="@AppIcons.Calendar" Size="20" />
        </button>
    </div>

    <div class="ct-datebar">
        <button class="ct-datebtn" @onclick="PrevDay" aria-label="Previous day"><AppIcon Name="@AppIcons.ChevronLeft" Size="18" /></button>
        <button class="ct-datebtn" @onclick="() => _calendarOpen = true">
            @FormatDateHeading(_selectedDate)
        </button>
        <button class="ct-datebtn" @onclick="NextDay" aria-label="Next day"><AppIcon Name="@AppIcons.ChevronRight" Size="18" /></button>
    </div>
</div>

@if (_loading)
{
    <div class="ct-diary-fixed">
        <div class="ct-card" style="text-align:center; padding:32px;">
            <div class="ct-muted">Loading your SQLite diary...</div>
        </div>
    </div>
}
else
{
    @if (_profile.PinCalorieSummary)
    {
        <!-- Fixed Daily Calorie Ring & Macro Summary -->
        <div class="ct-diary-fixed">
            @RenderCalorieSummary()
        </div>
    }

    <!-- Scrollable Diary Content -->
    <div class="ct-diary-scroll" style="@(_profile.PinCalorieSummary ? null : "padding-top:12px;")">
        @if (!_profile.PinCalorieSummary)
        {
            @RenderCalorieSummary()
        }
        @foreach (var slot in _slots)
        {
            if (slot.IsWaterTracker)
            {
                <!-- Daily Water Tracker Card -->
                <div class="ct-card" style="padding:13px 16px;">
                    <div style="display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:8px;">
                        <div style="display:flex; align-items:center; gap:6px;">
                            <span style="color:var(--ct-green);"><AppIcon Name="@AppIcons.Water" Size="17" /></span>
                            <strong style="font-size:0.94rem;">Water</strong>
                            <span class="ct-muted">
                                @_waterLog.AmountMl / @_profile.DailyWaterGoalMl ml
                            </span>
                        </div>
                        <div style="display:flex; gap:4px;">
                            <button class="ct-btn ct-btn-outline ct-btn-sm" @onclick="() => AdjustWaterAsync(-250)">-250</button>
                            <button class="ct-btn ct-btn-soft ct-btn-sm" @onclick="() => AdjustWaterAsync(250)">+250ml</button>
                            <button class="ct-btn ct-btn-soft ct-btn-sm" @onclick="() => AdjustWaterAsync(500)">+500</button>
                        </div>
                    </div>
                    @{
                        var waterPct = _profile.DailyWaterGoalMl > 0
                            ? Math.Clamp((double)_waterLog.AmountMl / _profile.DailyWaterGoalMl * 100.0, 0, 100)
                            : 0;
                    }
                    <div class="ct-bar-track" style="height:8px;">
                        <div class="ct-bar-fill" style="width:@waterPct.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%; background:#0ea5e9;"></div>
                    </div>
                </div>
            }
            else
            {
                var slotEntries = _entries.Where(e => e.MealSlotId == slot.Id).ToList();
                var slotKcal = slotEntries.Sum(e => e.CaloriesKcal);

                <div class="ct-card ct-slot-card">
                    <div class="ct-slot-head" role="button" tabindex="0" @onclick="() => OpenAddModal(slot)">
                        <div class="ct-slot-left">
                            <div class="ct-slot-icon"><AppIcon Name="@slot.Icon" Size="20" /></div>
                            <div>
                                <div class="ct-slot-name">@slot.Name</div>
                                <div class="ct-slot-kcal">
                                    @(slotEntries.Count == 0 ? "Nothing logged yet" : $"{slotKcal:0} kcal • {slotEntries.Count} item{(slotEntries.Count == 1 ? "" : "s")}")
                                </div>
                            </div>
                        </div>
                        <span class="ct-slot-plus" aria-hidden="true">+</span>
                    </div>

                    @if (slotEntries.Count > 0)
                    {
                        <div class="ct-slot-entries">
                            @foreach (var entry in slotEntries)
                            {
                                <div class="ct-entry-row">
                                    <div style="cursor:pointer; flex:1; min-width:0;" @onclick="() => OpenEditEntryModal(entry)">
                                        <div class="ct-entry-name">@entry.NameSnapshot</div>
                                        <div class="ct-entry-meta">
                                            @DiaryService.FormatEntryServing(entry) • P @entry.ProteinG.ToString("0")g • C @entry.CarbsG.ToString("0")g • F @entry.FatG.ToString("0")g
                                        </div>
                                    </div>
                                    <div class="ct-entry-right">
                                        <span class="ct-entry-kcal">@entry.CaloriesKcal.ToString("0") kcal</span>
                                        <button class="ct-icon-btn" title="Edit or duplicate" @onclick="() => OpenEditEntryModal(entry)"><AppIcon Name="@AppIcons.Edit" Size="16" /></button>
                                        <button class="ct-icon-btn" title="Remove entry" @onclick="() => DeleteEntryAsync(entry.Id)"><AppIcon Name="@AppIcons.Delete" Size="16" /></button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>
}
</div>

<!-- Edit / Duplicate Logged Entry Modal -->
@if (_editingEntry is not null)
{
    var todayDate = DateOnly.FromDateTime(DateTime.Today);
    var yesterdayDate = todayDate.AddDays(-1);
    var tomorrowDate = todayDate.AddDays(1);
    var editServingSize = ParsePositiveNumber(_editServingSizeText);
    var editServings = ParsePositiveNumber(_editServingsText);
    var editTotalQty = Math.Round(editServingSize * editServings, 1);

    <div class="ct-modal-backdrop" @onclick="() => _editingEntry = null">
        <div class="ct-modal" @onclick:stopPropagation="true">
            <div class="ct-modal-head">
                <strong>@(_isDuplicateMode ? "Duplicate Item" : "Edit Logged Item")</strong>
                <button class="ct-icon-btn" @onclick="() => _editingEntry = null"><AppIcon Name="@AppIcons.Close" Size="18" /></button>
            </div>
            <div class="ct-modal-body">
                <div style="margin-bottom:10px;">
                    <div style="font-weight:700; font-size:1rem;">@_editingEntry.NameSnapshot</div>
                    @if (!string.IsNullOrWhiteSpace(_editingEntry.BrandSnapshot))
                    {
                        <div class="ct-muted" style="font-size:0.78rem;">@_editingEntry.BrandSnapshot</div>
                    }
                </div>

                <div class="ct-tabs" style="margin-bottom:12px;">
                    <button type="button" class="ct-tab @(!_isDuplicateMode ? "active" : "")"
                            @onclick="() => _isDuplicateMode = false">
                        <AppIcon Name="@AppIcons.Edit" Size="14" /> Edit
                    </button>
                    <button type="button" class="ct-tab @(_isDuplicateMode ? "active" : "")"
                            @onclick="() => _isDuplicateMode = true">
                        <AppIcon Name="@AppIcons.Copy" Size="14" /> Duplicate
                    </button>
                </div>

                <div class="ct-grid-2">
                    <div class="ct-field">
                        <label class="ct-label">Serving size (@_editUnit)</label>
                        <input class="ct-input" type="number" inputmode="decimal" step="1" min="0.1"
                               value="@_editServingSizeText" @oninput="OnEditServingSizeInput" @onchange="OnEditServingSizeInput" />
                    </div>
                    <div class="ct-field">
                        <label class="ct-label">Unit</label>
                        <div class="ct-tabs">
                            <button type="button" class="ct-tab @(_editUnit == "g" ? "active" : "")" @onclick='() => _editUnit = "g"'>g</button>
                            <button type="button" class="ct-tab @(_editUnit == "ml" ? "active" : "")" @onclick='() => _editUnit = "ml"'>ml</button>
                        </div>
                    </div>
                </div>

                <div class="ct-field" style="margin-top:2px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; gap:8px;">
                        <label class="ct-label" style="margin:0;">Servings</label>
                        @if (editServings > 0 && Math.Abs(editServings - 1.0) >= 0.005)
                        {
                            <span class="ct-muted" style="font-size:0.76rem;">Total: @($"{editTotalQty:0.#}{_editUnit}")</span>
                        }
                    </div>
                    <div style="display:flex; gap:6px; align-items:center;">
                        <button type="button"
                                class="ct-btn ct-btn-sm @(Math.Abs(editServings - 1.0) < 0.005 ? "ct-btn-soft" : "ct-btn-outline")"
                                style="min-width:46px; height:42px;"
                                @onclick="() => SetEditServings(1)">
                            1x
                        </button>
                        <button type="button"
                                class="ct-btn ct-btn-sm @(Math.Abs(editServings - 2.0) < 0.005 ? "ct-btn-soft" : "ct-btn-outline")"
                                style="min-width:46px; height:42px;"
                                @onclick="() => SetEditServings(2)">
                            2x
                        </button>
                        <input class="ct-input" style="flex:1;" type="number" inputmode="decimal" step="0.5" min="0.1"
                               placeholder="Other (e.g. 5)"
                               value="@_editServingsText" @oninput="OnEditServingsInput" @onchange="OnEditServingsInput" />
                    </div>
                </div>

                <div class="ct-field">
                    <label class="ct-label">Meal Time</label>
                    <select class="ct-select" @bind="_editSlotId">
                        @foreach (var s in FoodSlots)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>

                <div class="ct-field">
                    <label class="ct-label">Date</label>
                    <div style="display:flex; gap:6px; margin-bottom:6px; flex-wrap:wrap;">
                        <button type="button"
                                class="ct-btn ct-btn-sm @(_editDate == yesterdayDate ? "ct-btn-soft" : "ct-btn-outline")"
                                @onclick="() => _editDate = yesterdayDate">
                            Yesterday
                        </button>
                        <button type="button"
                                class="ct-btn ct-btn-sm @(_editDate == todayDate ? "ct-btn-soft" : "ct-btn-outline")"
                                @onclick="() => _editDate = todayDate">
                            Today
                        </button>
                        <button type="button"
                                class="ct-btn ct-btn-sm @(_editDate == tomorrowDate ? "ct-btn-soft" : "ct-btn-outline")"
                                @onclick="() => _editDate = tomorrowDate">
                            Tomorrow
                        </button>
                    </div>
                    <input class="ct-input" type="date" @bind="_editDate" />
                </div>

                @{
                    var ratio = _editingEntry.QuantityGrams > 0
                        ? editTotalQty / _editingEntry.QuantityGrams
                        : (_editingEntry.Servings > 0 ? editServings / _editingEntry.Servings : 1.0);
                    var preview = _editingEntry.Nutrients.Scale(Math.Max(0, ratio));
                }
                <div class="ct-macro-row" style="margin-top:8px; margin-bottom:14px;">
                    <div class="ct-macro-pill">
                        <div class="ct-macro-name">Calories</div>
                        <div class="ct-macro-val" style="color:var(--ct-green-dark)">@preview.CaloriesKcal.ToString("0") kcal</div>
                    </div>
                    <div class="ct-macro-pill">
                        <div class="ct-macro-name">Protein</div>
                        <div class="ct-macro-val">@preview.ProteinG.ToString("0.0")g</div>
                    </div>
                    <div class="ct-macro-pill">
                        <div class="ct-macro-name">Carbs</div>
                        <div class="ct-macro-val">@preview.CarbsG.ToString("0.0")g</div>
                    </div>
                    <div class="ct-macro-pill">
                        <div class="ct-macro-name">Fat</div>
                        <div class="ct-macro-val">@preview.FatG.ToString("0.0")g</div>
                    </div>
                </div>

                <button class="ct-btn ct-btn-primary" style="width:100%;" disabled="@(editTotalQty <= 0 || editServings <= 0)" @onclick="SaveEntryModalAsync">
                    @if (_isDuplicateMode)
                    {
                        <AppIcon Name="@AppIcons.Copy" Size="16" /> <span>Duplicate Item</span>
                    }
                    else
                    {
                        <span>Save Changes</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@if (!_loading && FoodSlots.Count > 0)
{
    <button class="ct-fab" title="Log food" aria-label="Log food" @onclick="OpenQuickLogModal">
        +
    </button>
}

<AddFoodModal IsOpen="_addModalOpen"
              Date="_selectedDate"
              MealSlotId="_activeSlotId"
              MealSlotName="@_activeSlotName"
              MealSlots="FoodSlots"
              OnLogged="LoadDayAsync"
              OnClose="() => _addModalOpen = false" />

<CalendarModal IsOpen="_calendarOpen"
               SelectedDate="_selectedDate"
               DailyGoal="_profile.DailyCalorieGoal"
               OnDateSelected="OnDatePickedAsync"
               OnClose="() => _calendarOpen = false" />

@code {
    private DateOnly _selectedDate = DateOnly.FromDateTime(DateTime.Today);
    private UserProfile _profile = new();
    private List<MealSlot> _slots = new();
    private List<MealSlot> FoodSlots => _slots.Where(s => !s.IsWaterTracker).ToList();
    private List<FoodLogEntry> _entries = new();
    private WaterLog _waterLog = new();
    private NutrientProfile _totals = NutrientProfile.Zero;
    private bool _loading = true;
    private bool _showAllNutrients;
    private bool _calendarOpen;
    private bool _addModalOpen;
    private Guid _activeSlotId;
    private string _activeSlotName = string.Empty;
    private string? _toast;

    private FoodLogEntry? _editingEntry;
    private double _editInitialServingSize;
    private string _editServingSizeText = "100";
    private string _editServingsText = "1";
    private string _editUnit = "g";
    private Guid _editSlotId;
    private DateOnly _editDate;
    private bool _isDuplicateMode;

    protected override async Task OnInitializedAsync()
    {
        await LoadDayAsync();
    }

    private async Task LoadDayAsync()
    {
        _loading = true;
        _profile = await ProfileRepo.GetOrCreateAsync();
        _slots = await SlotRepo.GetAllAsync();
        _entries = await LogRepo.GetByDateAsync(_selectedDate);
        _waterLog = await WaterRepo.GetByDateAsync(_selectedDate);
        _totals = DiaryService.SumNutrients(_entries);
        _loading = false;
    }

    private async Task AdjustWaterAsync(int deltaMl)
    {
        _waterLog.Date = _selectedDate;
        _waterLog.AmountMl = Math.Max(0, _waterLog.AmountMl + deltaMl);
        await WaterRepo.SaveAsync(_waterLog);
    }

    private async Task CopyYesterdayAsync()
    {
        var count = await Diary.CopyEntriesFromDateAsync(_selectedDate.AddDays(-1), _selectedDate);
        _toast = count > 0
            ? $"Copied {count} item(s) from {_selectedDate.AddDays(-1):dd MMM}."
            : $"Nothing was logged on {_selectedDate.AddDays(-1):dd MMM} to copy.";
        await LoadDayAsync();
    }

    private void OpenEditEntryModal(FoodLogEntry entry, bool duplicate = false)
    {
        _editingEntry = entry;
        _isDuplicateMode = duplicate;
        var initialServings = entry.Servings > 0 ? Math.Round(entry.Servings, 2) : 1.0;
        var initialTotal = entry.QuantityGrams > 0 ? entry.QuantityGrams : 100.0;
        var perServing = Math.Round(initialTotal / initialServings, 2);
        if (perServing <= 0)
        {
            perServing = initialTotal;
            initialServings = 1;
        }
        _editInitialServingSize = perServing;
        _editServingSizeText = perServing.ToString("0.##", CultureInfo.InvariantCulture);
        _editServingsText = initialServings.ToString("0.##", CultureInfo.InvariantCulture);
        _editUnit = entry.UnitLabel;
        _editDate = entry.Date;
        _editSlotId = FoodSlots.Any(s => s.Id == entry.MealSlotId)
            ? entry.MealSlotId
            : (FoodSlots.FirstOrDefault()?.Id ?? entry.MealSlotId);
    }

    private static double ParsePositiveNumber(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return 0;
        var normalized = text.Trim().Replace(',', '.');
        return double.TryParse(normalized, NumberStyles.Any, CultureInfo.InvariantCulture, out var val) && val > 0
            ? val
            : 0;
    }

    private void OnEditServingSizeInput(ChangeEventArgs e)
    {
        _editServingSizeText = e.Value?.ToString() ?? string.Empty;
    }

    private void SetEditServings(double count)
    {
        _editServingsText = count.ToString("0.##", CultureInfo.InvariantCulture);
    }

    private void OnEditServingsInput(ChangeEventArgs e)
    {
        _editServingsText = e.Value?.ToString() ?? string.Empty;
    }

    private async Task SaveEntryModalAsync()
    {
        var servingSize = ParsePositiveNumber(_editServingSizeText);
        var servings = ParsePositiveNumber(_editServingsText);
        var totalQty = Math.Round(servingSize * servings, 1);
        if (_editingEntry is null || totalQty <= 0 || servings <= 0) return;

        var slotName = FoodSlots.FirstOrDefault(s => s.Id == _editSlotId)?.Name ?? "Diary";
        var itemName = _editingEntry.NameSnapshot;
        var targetDate = _editDate;

        string? servingLabel;
        if (_editingEntry.MealId.HasValue && Math.Abs(servingSize - _editInitialServingSize) < 0.05)
        {
            servingLabel = Math.Abs(servings - 1.0) < 0.005 ? "1 serving" : $"{servings:0.##} servings";
        }
        else
        {
            servingLabel = Math.Abs(servings - 1.0) < 0.005
                ? null
                : $"{servings:0.##} × {servingSize:0.#}{_editUnit} ({totalQty:0.#}{_editUnit})";
        }

        if (_isDuplicateMode)
        {
            await Diary.DuplicateEntryAsync(_editingEntry, targetDate, _editSlotId, totalQty, _editUnit, servings, servingLabel);
            _toast = targetDate == _selectedDate
                ? $"Duplicated \"{itemName}\" into {slotName}."
                : $"Duplicated \"{itemName}\" into {slotName} on {targetDate:dd MMM}.";
        }
        else
        {
            await Diary.UpdateEntryQuantityAsync(_editingEntry, totalQty, _editSlotId, targetDate, _editUnit, servings, servingLabel);
            _toast = targetDate != _selectedDate
                ? $"Moved \"{itemName}\" to {slotName} on {targetDate:dd MMM}."
                : "Updated logged item.";
        }

        _editingEntry = null;
        await LoadDayAsync();
    }

    private async Task PrevDay()
    {
        _toast = null;
        _selectedDate = _selectedDate.AddDays(-1);
        await LoadDayAsync();
    }

    private async Task NextDay()
    {
        _toast = null;
        _selectedDate = _selectedDate.AddDays(1);
        await LoadDayAsync();
    }

    private async Task OnDatePickedAsync(DateOnly date)
    {
        _toast = null;
        _selectedDate = date;
        await LoadDayAsync();
    }

    private void OpenAddModal(MealSlot slot)
    {
        _toast = null;
        _activeSlotId = slot.Id;
        _activeSlotName = slot.Name;
        _addModalOpen = true;
    }

    private void OpenQuickLogModal()
    {
        var foodSlots = FoodSlots;
        if (foodSlots.Count == 0) return;
        OpenAddModal(foodSlots[0]);
    }

    private async Task DeleteEntryAsync(Guid id)
    {
        await LogRepo.SoftDeleteAsync(id);
        await LoadDayAsync();
    }

    private static string FormatDateHeading(DateOnly d)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (d == today) return $"Today, {d:dd MMM}";
        if (d == today.AddDays(-1)) return $"Yesterday, {d:dd MMM}";
        if (d == today.AddDays(1)) return $"Tomorrow, {d:dd MMM}";
        return d.ToString("ddd, dd MMM yyyy");
    }

    private RenderFragment RenderCalorieSummary() => __builder =>
    {
        @if (!string.IsNullOrWhiteSpace(_toast))
        {
            <div class="ct-alert ct-alert-success">@_toast</div>
        }

        @if (_profile.SummaryStyle == CalorieSummaryStyle.Minimal)
        {
            var goal = _profile.DailyCalorieGoal;
            var remaining = goal - _totals.CaloriesKcal;
            var isOver = _totals.CaloriesKcal > goal;
            var kcalPct = goal > 0 ? Math.Clamp(_totals.CaloriesKcal / goal * 100.0, 0, 100) : 0;
            var kcalPctStr = kcalPct.ToString("0", System.Globalization.CultureInfo.InvariantCulture);

            <div class="ct-card ct-summary-compact">
                <div class="ct-compact-head">
                    <div class="ct-compact-kcal">
                        <strong>@_totals.CaloriesKcal.ToString("0")</strong>
                        <span class="ct-muted">/ @goal.ToString("0") kcal</span>
                    </div>
                    <div class="ct-compact-right">
                        <span class="ct-compact-left" style="color:@(isOver ? "var(--ct-red)" : "var(--ct-green-dark)")">
                            @Math.Abs(remaining).ToString("0") kcal @(isOver ? "over" : "left")
                        </span>
                        <button class="ct-icon-btn" style="width:28px; height:28px;" title="Copy Yesterday" aria-label="Copy Yesterday" @onclick="CopyYesterdayAsync">
                            <AppIcon Name="@AppIcons.Copy" Size="15" />
                        </button>
                        <button class="ct-icon-btn" style="width:28px; height:28px;" title="@(_showAllNutrients ? "Hide nutrients" : "All nutrients")" aria-label="Toggle nutrients" @onclick="() => _showAllNutrients = !_showAllNutrients">
                            <AppIcon Name="@(_showAllNutrients ? AppIcons.ChevronUp : AppIcons.ChevronDown)" Size="15" />
                        </button>
                    </div>
                </div>

                <div class="ct-bar-track" style="height:7px; margin:7px 0;">
                    <div class="ct-bar-fill" style="width:@kcalPctStr%; background:@(isOver ? "var(--ct-red)" : "var(--ct-green)");"></div>
                </div>

                <div class="ct-compact-macros">
                    <span><span class="ct-dot" style="background:#2563eb;"></span>C <strong>@_totals.CarbsG.ToString("0")</strong>/@_profile.CarbsGoalG.ToString("0")g</span>
                    <span><span class="ct-dot" style="background:#16a34a;"></span>P <strong>@_totals.ProteinG.ToString("0")</strong>/@_profile.ProteinGoalG.ToString("0")g</span>
                    <span><span class="ct-dot" style="background:#f59e0b;"></span>F <strong>@_totals.FatG.ToString("0")</strong>/@_profile.FatGoalG.ToString("0")g</span>
                    <span><span class="ct-dot" style="background:#ec4899;"></span>S <strong>@_totals.SugarsG.ToString("0")</strong>/@_profile.SugarGoalG.ToString("0")g</span>
                </div>

                @if (_showAllNutrients)
                {
                    @RenderExtraNutrientsList()
                }
            </div>
        }
        else
        {
            var isCompact = _profile.SummaryStyle == CalorieSummaryStyle.Compact;

            <div class="ct-card @(isCompact ? "ct-summary-ring-compact" : "")">
                <div class="ct-summary-grid">
                    <div class="ct-stat-col">
                        <div class="ct-stat-val">@_profile.DailyCalorieGoal.ToString("0")</div>
                        <div class="ct-stat-lbl">Goal</div>
                    </div>

                    <CalorieRing Consumed="_totals.CaloriesKcal" Goal="_profile.DailyCalorieGoal" Compact="isCompact" />

                    <div class="ct-stat-col">
                        <div class="ct-stat-val" style="color:var(--ct-green-dark)">@_totals.CaloriesKcal.ToString("0")</div>
                        <div class="ct-stat-lbl">Eaten</div>
                    </div>
                </div>

                @if (!isCompact)
                {
                    @RenderMacrosRow()
                }

                <div style="display:flex; justify-content:center; gap:8px; margin-top:@(isCompact ? "8px" : "10px"); flex-wrap:wrap;">
                    <button class="ct-btn ct-btn-outline ct-btn-sm" @onclick="() => _showAllNutrients = !_showAllNutrients">
                        @(_showAllNutrients ? "Hide nutrients" : "All nutrients")
                        <AppIcon Name="@(_showAllNutrients ? AppIcons.ChevronUp : AppIcons.ChevronDown)" Size="14" />
                    </button>
                    <button class="ct-btn ct-btn-outline ct-btn-sm" @onclick="CopyYesterdayAsync">
                        <AppIcon Name="@AppIcons.Copy" Size="14" /> Copy Yesterday
                    </button>
                </div>

                @if (_showAllNutrients)
                {
                    @if (isCompact)
                    {
                        @RenderMacrosRow()
                    }
                    @RenderExtraNutrientsList()
                }
            </div>
        }
    };

    private RenderFragment RenderMacrosRow() => __builder =>
    {
        <div class="ct-macro-row">
            @RenderMacroPill("Carbs", _totals.CarbsG, _profile.CarbsGoalG, "#2563eb")
            @RenderMacroPill("Protein", _totals.ProteinG, _profile.ProteinGoalG, "#16a34a")
            @RenderMacroPill("Fat", _totals.FatG, _profile.FatGoalG, "#f59e0b")
            @RenderMacroPill("Sugars", _totals.SugarsG, _profile.SugarGoalG, "#ec4899")
        </div>
    };

    private RenderFragment RenderExtraNutrientsList() => __builder =>
    {
        <div class="ct-nutrient-list">
            @RenderNutrientRow("Saturated Fat", _totals.SaturatedFatG, _profile.SaturatedFatGoalG, "g", "#f97316")
            @RenderNutrientRow("Sugars", _totals.SugarsG, _profile.SugarGoalG, "g", "#ec4899")
            @RenderNutrientRow("Fibre", _totals.FibreG, _profile.FibreGoalG, "g", "#10b981")
            @RenderNutrientRow("Salt", _totals.SaltG, _profile.SaltGoalG, "g", "#6366f1")
        </div>
    };

    private RenderFragment RenderMacroPill(string name, double value, double goal, string color) => __builder =>
    {
        var pct = goal > 0 ? Math.Clamp(value / goal * 100.0, 0, 100) : 0;
        <div class="ct-macro-pill">
            <div class="ct-macro-name">@name</div>
            <div class="ct-macro-val">@value.ToString("0")<span style="font-weight:400; color:var(--ct-text-muted)">/@goal.ToString("0")g</span></div>
            <div class="ct-bar-track">
                <div class="ct-bar-fill" style="width:@pct.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%; background:@color;"></div>
            </div>
        </div>
    };

    private RenderFragment RenderNutrientRow(string label, double value, double goal, string unit, string color) => __builder =>
    {
        var pct = goal > 0 ? Math.Clamp(value / goal * 100.0, 0, 100) : 0;
        <div class="ct-nutrient-item">
            <span style="font-weight:600;">@label</span>
            <div class="ct-bar-track">
                <div class="ct-bar-fill" style="width:@pct.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%; background:@color;"></div>
            </div>
            <span style="text-align:right; color:var(--ct-text-muted);">@value.ToString("0.##") / @goal.ToString("0.#")@unit</span>
        </div>
    };
}

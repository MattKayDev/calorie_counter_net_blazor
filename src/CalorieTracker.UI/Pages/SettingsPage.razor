@page "/settings"
@using System.Globalization
@inject IUserProfileRepository ProfileRepo
@inject IBodyMeasurementRepository BodyRepo
@inject IMealSlotRepository SlotRepo
@inject IDatabaseBackupService BackupService
@inject IFileDownloadService FileDownload
@inject IThemeService ThemeService
@inject IAppUpdateService AppUpdate
@inject AppLayoutState LayoutState
@inject DiaryService Diary
@inject NavigationManager Nav

<div class="ct-topbar">
    <div class="ct-topbar-row">
        <div class="ct-topbar-left">
            @if (_section == SettingsSection.Menu)
            {
                <button class="ct-cog-btn" title="Back to Diary" @onclick='() => Nav.NavigateTo("")'><AppIcon Name="@AppIcons.ArrowLeft" Size="20" /></button>
                <div class="ct-brand">Settings</div>
            }
            else
            {
                <button class="ct-cog-btn" title="Back to Settings" @onclick="BackToMenu"><AppIcon Name="@AppIcons.ArrowLeft" Size="20" /></button>
                <div class="ct-brand">@GetSectionTitle(_section)</div>
            }
        </div>
        @if (_section == SettingsSection.MealSlots)
        {
            <button class="ct-cog-btn" title="Add Meal Time" aria-label="Add Meal Time" @onclick="OpenAddSlotModal">
                <AppIcon Name="@AppIcons.Plus" Size="22" />
            </button>
        }
    </div>
</div>

<div class="ct-page">
    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <div class="ct-alert ct-alert-success">@_status</div>
    }

    @if (_section == SettingsSection.Menu)
    {
        <!-- Main Settings Menu -->
        <div class="ct-card ct-menu-card">
            <button class="ct-menu-row" @onclick="() => OpenSectionAsync(SettingsSection.Appearance)">
                <div class="ct-menu-left">
                    <div class="ct-menu-icon"><AppIcon Name="@AppIcons.Palette" Size="20" /></div>
                    <div>
                        <div class="ct-menu-title">Appearance</div>
                        <div class="ct-menu-sub">Theme, accent colours, and diary layout</div>
                    </div>
                </div>
                <span class="ct-menu-chevron"><AppIcon Name="@AppIcons.ChevronRight" Size="18" /></span>
            </button>

            <button class="ct-menu-row" @onclick="() => OpenSectionAsync(SettingsSection.GoalPlanner)">
                <div class="ct-menu-left">
                    <div class="ct-menu-icon"><AppIcon Name="@AppIcons.Target" Size="20" /></div>
                    <div>
                        <div class="ct-menu-title">Weight Goal</div>
                        <div class="ct-menu-sub">Target weight, weekly pace, and calorie planner</div>
                    </div>
                </div>
                <span class="ct-menu-chevron"><AppIcon Name="@AppIcons.ChevronRight" Size="18" /></span>
            </button>

            <button class="ct-menu-row" @onclick="() => OpenSectionAsync(SettingsSection.NutritionGoals)">
                <div class="ct-menu-left">
                    <div class="ct-menu-icon"><AppIcon Name="@AppIcons.Nutrition" Size="20" /></div>
                    <div>
                        <div class="ct-menu-title">Nutrition Goals</div>
                        <div class="ct-menu-sub">Daily calorie, macro, nutrient, and water targets</div>
                    </div>
                </div>
                <span class="ct-menu-chevron"><AppIcon Name="@AppIcons.ChevronRight" Size="18" /></span>
            </button>

            <button class="ct-menu-row" @onclick="() => OpenSectionAsync(SettingsSection.ProfileUnits)">
                <div class="ct-menu-left">
                    <div class="ct-menu-icon"><AppIcon Name="@AppIcons.User" Size="20" /></div>
                    <div>
                        <div class="ct-menu-title">Profile &amp; Units</div>
                        <div class="ct-menu-sub">Height, biological sex, and measurement units</div>
                    </div>
                </div>
                <span class="ct-menu-chevron"><AppIcon Name="@AppIcons.ChevronRight" Size="18" /></span>
            </button>

            <button class="ct-menu-row" @onclick="() => OpenSectionAsync(SettingsSection.MealSlots)">
                <div class="ct-menu-left">
                    <div class="ct-menu-icon"><AppIcon Name="@AppIcons.Foods" Size="20" /></div>
                    <div>
                        <div class="ct-menu-title">Meal Times</div>
                        <div class="ct-menu-sub">Add, reorder, or remove your daily meal slots</div>
                    </div>
                </div>
                <span class="ct-menu-chevron"><AppIcon Name="@AppIcons.ChevronRight" Size="18" /></span>
            </button>

            <button class="ct-menu-row" @onclick='() => Nav.NavigateTo("foods")'>
                <div class="ct-menu-left">
                    <div class="ct-menu-icon"><AppIcon Name="@AppIcons.Barcode" Size="20" /></div>
                    <div>
                        <div class="ct-menu-title">Food Library</div>
                        <div class="ct-menu-sub">Browse foods, barcode scan, custom foods, and saved meals</div>
                    </div>
                </div>
                <span class="ct-menu-chevron"><AppIcon Name="@AppIcons.ChevronRight" Size="18" /></span>
            </button>

            <button class="ct-menu-row" @onclick="() => OpenSectionAsync(SettingsSection.Backups)">
                <div class="ct-menu-left">
                    <div class="ct-menu-icon"><AppIcon Name="@AppIcons.Database" Size="20" /></div>
                    <div>
                        <div class="ct-menu-title">Backups</div>
                        <div class="ct-menu-sub">Export or restore your personal data and food library</div>
                    </div>
                </div>
                <span class="ct-menu-chevron"><AppIcon Name="@AppIcons.ChevronRight" Size="18" /></span>
            </button>

            <button class="ct-menu-row" @onclick="() => OpenSectionAsync(SettingsSection.Updates)">
                <div class="ct-menu-left">
                    <div class="ct-menu-icon"><AppIcon Name="@AppIcons.Refresh" Size="20" /></div>
                    <div>
                        <div class="ct-menu-title">Updates</div>
                        <div class="ct-menu-sub">
                            @(_updateAvailable ? "Update ready to install!" : "Check for and install newer app versions")
                        </div>
                    </div>
                </div>
                <span class="ct-menu-chevron"><AppIcon Name="@AppIcons.ChevronRight" Size="18" /></span>
            </button>
        </div>
    }
    else if (_section == SettingsSection.Appearance)
    {
        <div class="ct-card">
            <div style="display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:14px;">
                <div>
                    <h2 class="ct-card-title">Theme Mode</h2>
                    <div class="ct-muted">Switch between Light and Dark mode</div>
                </div>
                <div class="ct-tabs" style="width:170px;">
                    <button class="ct-tab @(_profile.ThemeMode == ThemeMode.Light ? "active" : "")"
                            @onclick="() => SetThemeAsync(ThemeMode.Light)">
                        <AppIcon Name="@AppIcons.LightMode" Size="14" /> Light
                    </button>
                    <button class="ct-tab @(_profile.ThemeMode == ThemeMode.Dark ? "active" : "")"
                            @onclick="() => SetThemeAsync(ThemeMode.Dark)">
                        <AppIcon Name="@AppIcons.DarkMode" Size="14" /> Dark
                    </button>
                </div>
            </div>

            <div style="font-weight:700; font-size:0.9rem; margin-bottom:4px;">Color Scheme</div>
            <div class="ct-muted">Choose your accent color (saved automatically)</div>

            <div class="ct-swatch-grid">
                @foreach (var opt in _colorOptions)
                {
                    <button class="ct-swatch @(_profile.ColorScheme == opt.Scheme ? "active" : "")"
                            @onclick="() => SetColorSchemeAsync(opt.Scheme)">
                        <span class="ct-swatch-dot" style="background:@opt.Hex;"></span>
                        <span>@opt.Label</span>
                    </button>
                }
            </div>
        </div>

        <div class="ct-card">
            <div>
                <h2 class="ct-card-title">Calorie Summary Style</h2>
                <div class="ct-muted">Choose full ring, compact ring, or minimal bar</div>
            </div>
            <div class="ct-tabs ct-tabs-3" style="margin-top:10px;">
                <button type="button" class="ct-tab @(_profile.SummaryStyle == CalorieSummaryStyle.Standard ? "active" : "")"
                        @onclick="() => SetSummaryStyleAsync(CalorieSummaryStyle.Standard)">
                    Standard
                </button>
                <button type="button" class="ct-tab @(_profile.SummaryStyle == CalorieSummaryStyle.Compact ? "active" : "")"
                        @onclick="() => SetSummaryStyleAsync(CalorieSummaryStyle.Compact)">
                    Compact
                </button>
                <button type="button" class="ct-tab @(_profile.SummaryStyle == CalorieSummaryStyle.Minimal ? "active" : "")"
                        @onclick="() => SetSummaryStyleAsync(CalorieSummaryStyle.Minimal)">
                    Minimal
                </button>
            </div>

            <div class="ct-setting-divider"></div>

            <div style="display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap;">
                <div style="flex:1; min-width:160px;">
                    <h2 class="ct-card-title">Calorie Summary Position</h2>
                    <div class="ct-muted">Keep fixed at the top or scroll with your meal times</div>
                </div>
                <div class="ct-tabs" style="width:190px; flex-shrink:0;">
                    <button type="button" class="ct-tab @(_profile.PinCalorieSummary ? "active" : "")"
                            @onclick="() => SetPinCalorieSummaryAsync(true)">
                        Fixed
                    </button>
                    <button type="button" class="ct-tab @(!_profile.PinCalorieSummary ? "active" : "")"
                            @onclick="() => SetPinCalorieSummaryAsync(false)">
                        Scrollable
                    </button>
                </div>
            </div>

            <div class="ct-setting-divider"></div>

            <div style="display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap;">
                <div style="flex:1; min-width:160px;">
                    <h2 class="ct-card-title">Foods in Bottom Menu</h2>
                    <div class="ct-muted">Always accessible from the Settings menu</div>
                </div>
                <div class="ct-tabs" style="width:190px; flex-shrink:0;">
                    <button type="button" class="ct-tab @(_profile.ShowFoodsInBottomNav ? "active" : "")"
                            @onclick="() => SetShowFoodsInBottomNavAsync(true)">
                        Show
                    </button>
                    <button type="button" class="ct-tab @(!_profile.ShowFoodsInBottomNav ? "active" : "")"
                            @onclick="() => SetShowFoodsInBottomNavAsync(false)">
                        Hide
                    </button>
                </div>
            </div>
        </div>
    }
    else if (_section == SettingsSection.GoalPlanner)
    {
        <div class="ct-card">
            <div class="ct-muted" style="margin-bottom:12px;">
                Calculates your BMR, TDEE, estimated daily calories, and projected target date.
            </div>

            @if (_latestWeightKg is null)
            {
                <div class="ct-field" style="margin-bottom:12px;">
                    <label class="ct-label">Current Weight (@UnitConverter.WeightUnitLabel(_profile.UnitSystem))</label>
                    <input class="ct-input" type="number" inputmode="decimal" step="0.1"
                           placeholder="Required to estimate daily calories"
                           value="@_currentWeightText" @oninput="OnCurrentWeightInput" @onchange="OnCurrentWeightInput" />
                </div>
            }

            <div class="ct-grid-2">
                <div class="ct-field">
                    <label class="ct-label">Goal Weight (@UnitConverter.WeightUnitLabel(_profile.UnitSystem))</label>
                    <input class="ct-input" type="number" inputmode="decimal" step="0.1"
                           value="@_goalWeightText" @oninput="OnGoalWeightInput" @onchange="OnGoalWeightInput" />
                </div>
                <div class="ct-field">
                    <label class="ct-label">Target Weekly Pace</label>
                    <select class="ct-select" @bind="_profile.WeeklyWeightChangeKg">
                        <option value="-1">Lose 1.0 kg / wk (fast)</option>
                        <option value="-0.75">Lose 0.75 kg / wk</option>
                        <option value="-0.5">Lose 0.5 kg / wk (steady)</option>
                        <option value="-0.25">Lose 0.25 kg / wk (gentle)</option>
                        <option value="0">Maintain weight</option>
                        <option value="0.25">Gain 0.25 kg / wk (lean)</option>
                        <option value="0.5">Gain 0.5 kg / wk</option>
                    </select>
                </div>
                <div class="ct-field">
                    <label class="ct-label">Age (years)</label>
                    <input class="ct-input" type="number" min="13" max="120" @bind="_profile.AgeYears" @bind:event="oninput" />
                </div>
                <div class="ct-field">
                    <label class="ct-label">Activity Level</label>
                    <select class="ct-select" @bind="_profile.ActivityLevel">
                        <option value="@ActivityLevel.Sedentary">Sedentary (desk job)</option>
                        <option value="@ActivityLevel.Light">Light (1–3 days/wk)</option>
                        <option value="@ActivityLevel.Moderate">Moderate (3–5 days/wk)</option>
                        <option value="@ActivityLevel.Active">Active (6–7 days/wk)</option>
                        <option value="@ActivityLevel.VeryActive">Very Active (physical job)</option>
                    </select>
                </div>
            </div>

            @{
                var effectiveCurrentKg = GetEffectiveCurrentWeightKg();
                var effectiveGoalKg = GetEffectiveGoalWeightKg();
                var tdee = GoalWeightCalculator.CalculateTdee(effectiveCurrentKg, _profile.HeightCm, _profile.AgeYears, _profile.BiologicalSex, _profile.ActivityLevel);
                var recommended = tdee.HasValue ? GoalWeightCalculator.CalculateRecommendedDailyCalories(tdee.Value, _profile.WeeklyWeightChangeKg) : (double?)null;
                var caloriesDiffer = recommended.HasValue && Math.Abs(Math.Round(_profile.DailyCalorieGoal) - Math.Round(recommended.Value)) >= 1;
                var projection = (tdee.HasValue && recommended.HasValue && effectiveCurrentKg.HasValue && effectiveGoalKg.HasValue)
                    ? GoalWeightCalculator.ProjectGoalDate(DateOnly.FromDateTime(DateTime.Today), effectiveCurrentKg.Value, effectiveGoalKg.Value, tdee.Value, recommended.Value)
                    : null;
            }
            @if (recommended is double rec)
            {
                <div class="ct-alert ct-alert-info" style="display:flex; justify-content:space-between; align-items:center; gap:10px; margin-bottom:12px;">
                    <div>
                        <div>Estimated daily calories: <strong>@rec.ToString("0") kcal/day</strong></div>
                        <div style="font-size:0.78rem; opacity:0.88; margin-top:2px;">
                            TDEE ~@tdee!.Value.ToString("0") kcal
                            @if (projection is not null)
                            {
                                @if (projection.AlreadyReached)
                                {
                                    <span> • Goal weight reached</span>
                                }
                                else if (projection.IsMovingTowardGoal && projection.EstimatedDate.HasValue)
                                {
                                    <span> • Est. goal: @projection.EstimatedDate.Value.ToString("d MMM yyyy")</span>
                                }
                                else
                                {
                                    <span> • Adjust pace to match goal direction</span>
                                }
                            }
                        </div>
                    </div>
                    @if (caloriesDiffer)
                    {
                        <button class="ct-btn ct-btn-primary ct-btn-sm" style="flex-shrink:0;" @onclick="() => ApplyRecommendedCaloriesAsync(rec)">Apply &amp; Save</button>
                    }
                </div>
            }
            else
            {
                <div class="ct-alert ct-alert-warn" style="margin-bottom:12px;">
                    @if (!effectiveCurrentKg.HasValue && _profile.HeightCm is not > 0)
                    {
                        <span>Enter your <strong>Current Weight</strong> above and set your <strong>Height</strong> in <strong>Profile &amp; Units</strong> to see estimated daily calories.</span>
                    }
                    else if (!effectiveCurrentKg.HasValue)
                    {
                        <span>Enter your <strong>Current Weight</strong> above to see estimated daily calories for your goal.</span>
                    }
                    else
                    {
                        <span>Set your <strong>Height</strong> in <strong>Profile &amp; Units</strong> to see estimated daily calories.</span>
                    }
                </div>
            }

            <button class="ct-btn ct-btn-primary" style="width:100%;" @onclick="SaveGoalSettingsAsync">
                Save Goal Settings
            </button>
        </div>
    }
    else if (_section == SettingsSection.NutritionGoals)
    {
        <div class="ct-card">
            <div class="ct-grid-2">
                <div class="ct-field">
                    <label class="ct-label">Daily Calorie Goal (kcal)</label>
                    <input class="ct-input" type="number" step="50" @bind="_profile.DailyCalorieGoal" />
                </div>
                <div class="ct-field">
                    <label class="ct-label">Daily Water Goal (ml)</label>
                    <input class="ct-input" type="number" step="250" @bind="_profile.DailyWaterGoalMl" />
                </div>
                <div class="ct-field">
                    <label class="ct-label">Protein Goal (g)</label>
                    <input class="ct-input" type="number" @bind="_profile.ProteinGoalG" />
                </div>
                <div class="ct-field">
                    <label class="ct-label">Carbs Goal (g)</label>
                    <input class="ct-input" type="number" @bind="_profile.CarbsGoalG" />
                </div>
                <div class="ct-field">
                    <label class="ct-label">Fat Goal (g)</label>
                    <input class="ct-input" type="number" @bind="_profile.FatGoalG" />
                </div>
                <div class="ct-field">
                    <label class="ct-label">Saturated Fat Max (g)</label>
                    <input class="ct-input" type="number" @bind="_profile.SaturatedFatGoalG" />
                </div>
                <div class="ct-field">
                    <label class="ct-label">Sugars Max (g)</label>
                    <input class="ct-input" type="number" @bind="_profile.SugarGoalG" />
                </div>
                <div class="ct-field">
                    <label class="ct-label">Salt Max (g)</label>
                    <input class="ct-input" type="number" step="0.5" @bind="_profile.SaltGoalG" />
                </div>
                <div class="ct-field">
                    <label class="ct-label">Fibre Goal (g)</label>
                    <input class="ct-input" type="number" @bind="_profile.FibreGoalG" />
                </div>
            </div>

            <button class="ct-btn ct-btn-primary" style="width:100%; margin-top:6px;" @onclick="SaveProfileAsync">
                Save Nutrition Goals
            </button>
        </div>
    }
    else if (_section == SettingsSection.ProfileUnits)
    {
        <div class="ct-card">
            <div class="ct-form-grid">
                <label class="ct-label">Display Units</label>
                <select class="ct-select" value="@_profile.UnitSystem" @onchange="OnUnitSystemChanged">
                    <option value="@UnitSystem.Metric">Metric (kg, cm)</option>
                    <option value="@UnitSystem.UkImperial">UK Imperial (st/lb, ft/in)</option>
                    <option value="@UnitSystem.UsImperial">US Imperial (lbs, ft/in)</option>
                </select>

                <label class="ct-label">Height (cm)</label>
                <input class="ct-input" type="number" step="0.5" @bind="_profile.HeightCm" />

                <label class="ct-label">Biological Sex</label>
                <select class="ct-select" @bind="_profile.BiologicalSex">
                    <option value="@BiologicalSex.Unspecified">Not set</option>
                    <option value="@BiologicalSex.Male">Male</option>
                    <option value="@BiologicalSex.Female">Female</option>
                </select>
            </div>

            <div class="ct-muted" style="margin-bottom:12px;">
                Height and Biological Sex are used to calculate BMI, BMR, and US Navy Body Fat %.
            </div>

            <button class="ct-btn ct-btn-primary" style="width:100%;" @onclick="SaveProfileAsync">
                Save Profile &amp; Units
            </button>
        </div>
    }
    else if (_section == SettingsSection.MealSlots)
    {
        <div class="ct-card">
            <div style="display:flex; align-items:center; justify-content:space-between; gap:10px;">
                <div>
                    <h2 class="ct-card-title">Water Tracking</h2>
                    <div class="ct-muted">Show the daily water bar in your Diary</div>
                </div>
                <div class="ct-tabs" style="width:140px; flex-shrink:0;">
                    <button type="button" class="ct-tab @(_waterEnabled ? "active" : "")"
                            @onclick="() => SetWaterTrackingAsync(true)">
                        On
                    </button>
                    <button type="button" class="ct-tab @(!_waterEnabled ? "active" : "")"
                            @onclick="() => SetWaterTrackingAsync(false)">
                        Off
                    </button>
                </div>
            </div>
        </div>

        <div class="ct-card">
            <div class="ct-muted" style="margin-bottom:10px;">
                Customize and reorder your Diary sections (move Water up or down anytime, or tap a meal time to edit).
            </div>

            <div style="display:flex; flex-direction:column; gap:8px; margin-bottom:14px;">
                @for (var i = 0; i < _slots.Count; i++)
                {
                    var idx = i;
                    var slot = _slots[idx];
                    <div class="ct-entry-row" style="background:var(--ct-surface-muted); border-radius:10px;">
                        @if (slot.IsWaterTracker)
                        {
                            <div style="display:flex; align-items:center; gap:10px; flex:1;">
                                <span style="color:var(--ct-green); display:inline-flex;"><AppIcon Name="@AppIcons.Water" Size="18" /></span>
                                <strong>@slot.Name</strong>
                                <span class="ct-muted" style="font-size:0.75rem;">Tracker</span>
                            </div>
                        }
                        else
                        {
                            <div style="display:flex; align-items:center; gap:10px; cursor:pointer; flex:1;" @onclick="() => OpenEditSlotModal(slot)">
                                <span style="color:var(--ct-green); display:inline-flex;"><AppIcon Name="@slot.Icon" Size="18" /></span>
                                <strong>@slot.Name</strong>
                            </div>
                        }
                        <div style="display:flex; gap:2px; align-items:center;">
                            <button class="ct-icon-btn" title="Move up" disabled="@(idx == 0)" @onclick="() => MoveSlotAsync(idx, -1)"><AppIcon Name="@AppIcons.ChevronUp" Size="16" /></button>
                            <button class="ct-icon-btn" title="Move down" disabled="@(idx == _slots.Count - 1)" @onclick="() => MoveSlotAsync(idx, 1)"><AppIcon Name="@AppIcons.ChevronDown" Size="16" /></button>
                            @if (slot.IsWaterTracker)
                            {
                                <button class="ct-icon-btn" title="Turn off water tracking" @onclick="() => SetWaterTrackingAsync(false)"><AppIcon Name="@AppIcons.Delete" Size="16" /></button>
                            }
                            else
                            {
                                <button class="ct-icon-btn" title="Archive slot" @onclick="() => ArchiveSlotAsync(slot.Id)"><AppIcon Name="@AppIcons.Delete" Size="16" /></button>
                            }
                        </div>
                    </div>
                }
            </div>

            <button class="ct-btn ct-btn-primary" style="width:100%;" @onclick="OpenAddSlotModal">
                + Add Meal Time
            </button>
        </div>
    }
    else if (_section == SettingsSection.Backups)
    {
        <div class="ct-card">
            <div class="ct-card-header" style="align-items:flex-start; margin-bottom:8px;">
                <h2 class="ct-card-title"><span style="color:var(--ct-green);"><AppIcon Name="@AppIcons.Lock" Size="18" /></span> Private Personal Data</h2>
                <span class="ct-badge ct-badge-green" style="flex-shrink:0; white-space:nowrap;">
                    @(_loadingDbSizes && _personalDbBytes is null ? "..." : UnitConverter.FormatStorageSize(_personalDbBytes))
                </span>
            </div>
            <div class="ct-muted" style="margin-bottom:12px;">
                <code>personal.sqlite</code> — Contains your diary logs, body measurements, water logs, saved meals, and goals. Kept strictly private on this device.
            </div>

            <div style="display:flex; gap:10px; flex-wrap:wrap;">
                <button class="ct-btn ct-btn-primary" @onclick="ExportPersonalBackupAsync">
                    <AppIcon Name="@AppIcons.Download" Size="16" /> Export personal.sqlite
                </button>

                <label class="ct-btn ct-btn-outline" style="cursor:pointer;">
                    <AppIcon Name="@AppIcons.Upload" Size="16" /> Restore personal.sqlite
                    <InputFile OnChange="ImportPersonalBackupAsync" accept=".sqlite,.db" style="display:none;" />
                </label>
            </div>
        </div>

        <div class="ct-card">
            <div class="ct-card-header" style="align-items:flex-start; margin-bottom:8px;">
                <h2 class="ct-card-title"><span style="color:var(--ct-green);"><AppIcon Name="@AppIcons.Database" Size="18" /></span> Shareable Food Catalog</h2>
                <span class="ct-badge ct-badge-green" style="flex-shrink:0; white-space:nowrap;">
                    @(_loadingDbSizes && _foodsDbBytes is null ? "..." : UnitConverter.FormatStorageSize(_foodsDbBytes))
                </span>
            </div>
            <div class="ct-muted" style="margin-bottom:12px;">
                <code>foods.sqlite</code> — Contains only your food library (searched, scanned, and custom foods) with <strong>zero personal data</strong> — ready to export, share, or merge into a hosted database later.
            </div>

            <div style="display:flex; gap:10px; flex-wrap:wrap;">
                <button class="ct-btn ct-btn-soft" @onclick="ExportFoodsBackupAsync">
                    <AppIcon Name="@AppIcons.Download" Size="16" /> Export foods.sqlite
                </button>

                <label class="ct-btn ct-btn-outline" style="cursor:pointer;">
                    <AppIcon Name="@AppIcons.Upload" Size="16" /> Import / Restore foods.sqlite
                    <InputFile OnChange="ImportFoodsBackupAsync" accept=".sqlite,.db" style="display:none;" />
                </label>
            </div>
        </div>

        @if (_personalDbBytes.HasValue && _foodsDbBytes.HasValue)
        {
            <div class="ct-muted" style="text-align:center;">
                Total local database storage: <strong>@UnitConverter.FormatStorageSize(_personalDbBytes.Value + _foodsDbBytes.Value)</strong>
            </div>
        }
    }
    else if (_section == SettingsSection.Updates)
    {
        <div class="ct-card">
            <div class="ct-card-header" style="align-items:flex-start; margin-bottom:8px;">
                <h2 class="ct-card-title"><span style="color:var(--ct-green);"><AppIcon Name="@AppIcons.Refresh" Size="18" /></span> Check for App Updates</h2>
                <span class="ct-badge ct-badge-green" style="flex-shrink:0; white-space:nowrap;">
                    @AppInfo.DisplayVersion
                </span>
            </div>
            <div class="ct-muted" style="margin-bottom:14px;">
                Currently running <strong>@AppInfo.DisplayVersion</strong>. Check if a newer version has been published. Your data will stay completely intact when updating.
            </div>

            @if (!string.IsNullOrWhiteSpace(_updateMessage))
            {
                <div class="ct-alert @(_updateAvailable ? "ct-alert-success" : "ct-alert-info")" style="margin-bottom:12px;">
                    @_updateMessage
                </div>
            }

            <div style="display:flex; gap:10px; flex-wrap:wrap;">
                <button class="ct-btn ct-btn-soft" disabled="@_checkingUpdate" @onclick="CheckForUpdatesAsync">
                    <AppIcon Name="@AppIcons.Search" Size="16" /> @(_checkingUpdate ? "Checking..." : "Check for Updates")
                </button>

                @if (_updateAvailable)
                {
                    <button class="ct-btn ct-btn-primary" @onclick="ApplyUpdateAsync">
                        <AppIcon Name="@AppIcons.Download" Size="16" /> Update &amp; Reload Now
                    </button>
                }
            </div>
        </div>
    }
</div>

@if (_slotModalOpen)
{
    <div class="ct-modal-backdrop" @onclick="() => _slotModalOpen = false">
        <div class="ct-modal" @onclick:stopPropagation="true">
            <div class="ct-modal-head">
                <strong>@(_editingSlotId.HasValue ? "Edit Meal Time" : "Add Meal Time")</strong>
                <button class="ct-icon-btn" @onclick="() => _slotModalOpen = false"><AppIcon Name="@AppIcons.Close" Size="18" /></button>
            </div>
            <div class="ct-modal-body">
                <div class="ct-field">
                    <label class="ct-label">Name</label>
                    <input class="ct-input" placeholder="e.g. Drinks, Snacks, Pre-Workout" @bind="_newSlotName" />
                </div>

                <div class="ct-field" style="margin-top:6px;">
                    <label class="ct-label">Icon</label>
                    <div class="ct-swatch-grid">
                        @foreach (var opt in _mealIconOptions)
                        {
                            <button type="button"
                                    class="ct-swatch @(_newSlotIcon == opt.Icon ? "active" : "")"
                                    @onclick="() => _newSlotIcon = opt.Icon">
                                <span class="ct-swatch-icon"><AppIcon Name="@opt.Icon" Size="20" /></span>
                                <span>@opt.Label</span>
                            </button>
                        }
                    </div>
                </div>

                <button class="ct-btn ct-btn-primary" style="width:100%; margin-top:14px;" @onclick="SaveSlotModalAsync">
                    @(_editingSlotId.HasValue ? "Save Changes" : "Add Meal Time")
                </button>
            </div>
        </div>
    </div>
}

@if (_currentWeightModalOpen)
{
    <div class="ct-modal-backdrop" @onclick="() => _currentWeightModalOpen = false">
        <div class="ct-modal" @onclick:stopPropagation="true">
            <div class="ct-modal-head">
                <strong>Enter Current Weight</strong>
                <button class="ct-icon-btn" @onclick="() => _currentWeightModalOpen = false"><AppIcon Name="@AppIcons.Close" Size="18" /></button>
            </div>
            <div class="ct-modal-body">
                <div class="ct-muted" style="margin-bottom:12px;">
                    Enter your current weight so we can calculate your estimated daily calories for your goal.
                </div>

                <div class="ct-field">
                    <label class="ct-label">Current Weight (@UnitConverter.WeightUnitLabel(_profile.UnitSystem))</label>
                    <input class="ct-input" type="number" inputmode="decimal" step="0.1"
                           placeholder="Enter weight"
                           value="@_popupWeightText" @oninput="OnPopupWeightInput" @onchange="OnPopupWeightInput" />
                </div>

                @{
                    var popupCurrentKg = ConvertWeightInputToKg(ParsePositiveWeightInput(_popupWeightText));
                    var popupGoalKg = GetEffectiveGoalWeightKg();
                    var popupPace = (popupCurrentKg.HasValue && popupGoalKg.HasValue)
                        ? GoalWeightCalculator.AlignWeeklyPaceToGoal(popupCurrentKg.Value, popupGoalKg.Value, _profile.WeeklyWeightChangeKg)
                        : _profile.WeeklyWeightChangeKg;
                    var popupTdee = GoalWeightCalculator.CalculateTdee(popupCurrentKg, _profile.HeightCm, _profile.AgeYears, _profile.BiologicalSex, _profile.ActivityLevel);
                    var popupRec = popupTdee.HasValue ? GoalWeightCalculator.CalculateRecommendedDailyCalories(popupTdee.Value, popupPace) : (double?)null;
                    var popupCaloriesDiffer = popupRec.HasValue && Math.Abs(Math.Round(_profile.DailyCalorieGoal) - Math.Round(popupRec.Value)) >= 1;
                }

                @if (popupRec is double pRec)
                {
                    <div class="ct-alert ct-alert-info" style="margin-top:8px;">
                        Estimated daily calories: <strong>@pRec.ToString("0") kcal/day</strong> (TDEE ~@popupTdee!.Value.ToString("0") kcal)
                    </div>
                }

                <div style="display:flex; flex-direction:column; gap:8px; margin-top:14px;">
                    @if (popupRec is double applyRec && popupCaloriesDiffer)
                    {
                        <button class="ct-btn ct-btn-primary" style="width:100%;" @onclick="() => ConfirmPopupCurrentWeightAsync(applyCalories: true)">
                            Apply @applyRec.ToString("0") kcal &amp; Save
                        </button>
                        <button class="ct-btn ct-btn-soft" style="width:100%;" @onclick="() => ConfirmPopupCurrentWeightAsync(applyCalories: false)">
                            Save Weight &amp; Goal Only
                        </button>
                    }
                    else
                    {
                        <button class="ct-btn ct-btn-primary" style="width:100%;" disabled="@(!popupCurrentKg.HasValue)" @onclick="() => ConfirmPopupCurrentWeightAsync(applyCalories: false)">
                            Save Weight &amp; Goals
                        </button>
                    }
                    <button class="ct-btn ct-btn-outline" style="width:100%;" @onclick="SkipCurrentWeightPopupAsync">
                        Skip for now
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private enum SettingsSection
    {
        Menu,
        Appearance,
        GoalPlanner,
        NutritionGoals,
        ProfileUnits,
        MealSlots,
        Backups,
        Updates
    }

    private SettingsSection _section = SettingsSection.Menu;
    private bool _checkingUpdate;
    private bool _updateAvailable;
    private string? _updateMessage;
    private UserProfile _profile = new();
    private List<MealSlot> _slots = new();
    private bool _waterEnabled;
    private double? _latestWeightKg;
    private string _goalWeightText = string.Empty;
    private string _currentWeightText = string.Empty;
    private bool _currentWeightModalOpen;
    private string _popupWeightText = string.Empty;
    private string _newSlotName = string.Empty;
    private string _newSlotIcon = AppIcons.MealMain;
    private bool _slotModalOpen;
    private Guid? _editingSlotId;
    private long? _personalDbBytes;
    private long? _foodsDbBytes;
    private bool _loadingDbSizes;
    private string? _status;

    private static readonly (string Icon, string Label)[] _mealIconOptions =
    {
        (AppIcons.MealMorning, "Morning"),
        (AppIcons.MealMidday, "Midday"),
        (AppIcons.MealMain, "Meal"),
        (AppIcons.MealSnack, "Snack"),
        (AppIcons.MealTea, "Tea"),
        (AppIcons.MealDrink, "Drinks"),
        (AppIcons.MealEvening, "Evening"),
        (AppIcons.Nutrition, "Workout")
    };

    private static readonly (ColorScheme Scheme, string Label, string Hex)[] _colorOptions =
    {
        (ColorScheme.RoyalBlue, "Royal Blue", "#2563eb"),
        (ColorScheme.Green, "Green", "#16a34a"),
        (ColorScheme.Purple, "Purple", "#7c3aed"),
        (ColorScheme.Orange, "Orange", "#ea580c"),
        (ColorScheme.Red, "Red", "#dc2626"),
        (ColorScheme.Teal, "Teal", "#0d9488"),
        (ColorScheme.Rose, "Rose", "#db2777"),
        (ColorScheme.Indigo, "Indigo", "#4f46e5")
    };

    protected override async Task OnInitializedAsync()
    {
        _updateAvailable = AppUpdate.IsUpdateAvailable;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _profile = await ProfileRepo.GetOrCreateAsync();
        LayoutState.SetShowFoodsInBottomNav(_profile.ShowFoodsInBottomNav);
        var allSlots = await SlotRepo.GetAllAsync(includeArchived: true);
        _slots = allSlots.Where(s => !s.IsArchived).ToList();
        _waterEnabled = allSlots.Any(s => s.IsWaterTracker && !s.IsArchived);
        var allBody = await BodyRepo.GetAllAsync();
        _latestWeightKg = allBody.FirstOrDefault(m => m.WeightKg is > 0)?.WeightKg;
        if (_latestWeightKg.HasValue)
        {
            _currentWeightText = string.Empty;
        }
        SyncGoalWeightInput();
    }

    private async Task OpenSectionAsync(SettingsSection section)
    {
        _status = null;
        _section = section;
        if (section == SettingsSection.Backups)
        {
            await LoadDatabaseSizesAsync();
        }
    }

    private async Task LoadDatabaseSizesAsync()
    {
        _loadingDbSizes = true;
        StateHasChanged();
        try
        {
            _personalDbBytes = await BackupService.GetPersonalDatabaseSizeBytesAsync();
            _foodsDbBytes = await BackupService.GetFoodsDatabaseSizeBytesAsync();
        }
        finally
        {
            _loadingDbSizes = false;
        }
    }

    private void BackToMenu()
    {
        _status = null;
        _section = SettingsSection.Menu;
    }

    private static string GetSectionTitle(SettingsSection section) => section switch
    {
        SettingsSection.Appearance => "Appearance",
        SettingsSection.GoalPlanner => "Weight Goal",
        SettingsSection.NutritionGoals => "Nutrition Goals",
        SettingsSection.ProfileUnits => "Profile & Units",
        SettingsSection.MealSlots => "Meal Times",
        SettingsSection.Backups => "Backups",
        SettingsSection.Updates => "Updates",
        _ => "Settings"
    };

    private async Task CheckForUpdatesAsync()
    {
        _checkingUpdate = true;
        _updateMessage = "Checking for updates...";
        StateHasChanged();

        try
        {
            var result = await AppUpdate.CheckForUpdateAsync();
            _updateAvailable = result.UpdateAvailable;
            _updateMessage = string.IsNullOrWhiteSpace(result.Message)
                ? (_updateAvailable ? "A new version is ready to install!" : "You are up to date with the latest version.")
                : result.Message;
        }
        catch (Exception ex)
        {
            _updateMessage = $"Could not check for updates: {ex.Message}";
        }
        finally
        {
            _checkingUpdate = false;
            StateHasChanged();
        }
    }

    private Task ApplyUpdateAsync() => AppUpdate.ApplyUpdateAsync();

    private static double? ParsePositiveWeightInput(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return null;
        var normalized = text.Trim().Replace(',', '.');
        return double.TryParse(normalized, NumberStyles.Any, CultureInfo.InvariantCulture, out var value) && value > 0
            ? value
            : null;
    }

    private double? ConvertWeightInputToKg(double? input)
    {
        if (input is not > 0) return null;
        return _profile.UnitSystem == UnitSystem.Metric
            ? input.Value
            : UnitConverter.LbsToKg(input.Value);
    }

    private string FormatWeightInput(double kg)
    {
        var displayVal = _profile.UnitSystem == UnitSystem.Metric ? kg : UnitConverter.KgToLbs(kg);
        return Math.Round(displayVal, 2).ToString("0.##", CultureInfo.InvariantCulture);
    }

    private double? GetEffectiveCurrentWeightKg() =>
        _latestWeightKg ?? ConvertWeightInputToKg(ParsePositiveWeightInput(_currentWeightText));

    private double? GetEffectiveGoalWeightKg() =>
        ConvertWeightInputToKg(ParsePositiveWeightInput(_goalWeightText));

    private void SyncGoalWeightInput()
    {
        _goalWeightText = _profile.GoalWeightKg is double gw ? FormatWeightInput(gw) : string.Empty;
    }

    private void SyncGoalWeightToProfile()
    {
        _profile.GoalWeightKg = GetEffectiveGoalWeightKg();
    }

    private void AlignPaceIfBothWeightsKnown(double? currentKg, double? goalKg)
    {
        if (currentKg is > 0 && goalKg is > 0)
        {
            _profile.WeeklyWeightChangeKg = GoalWeightCalculator.AlignWeeklyPaceToGoal(
                currentKg.Value,
                goalKg.Value,
                _profile.WeeklyWeightChangeKg);
        }
    }

    private void OnGoalWeightInput(ChangeEventArgs e)
    {
        _goalWeightText = e.Value?.ToString() ?? string.Empty;
        AlignPaceIfBothWeightsKnown(GetEffectiveCurrentWeightKg(), GetEffectiveGoalWeightKg());
    }

    private void OnCurrentWeightInput(ChangeEventArgs e)
    {
        _currentWeightText = e.Value?.ToString() ?? string.Empty;
        AlignPaceIfBothWeightsKnown(GetEffectiveCurrentWeightKg(), GetEffectiveGoalWeightKg());
    }

    private void OnPopupWeightInput(ChangeEventArgs e)
    {
        _popupWeightText = e.Value?.ToString() ?? string.Empty;
    }

    private void OnUnitSystemChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<UnitSystem>(e.Value?.ToString(), out var next))
        {
            var currentGoalKg = GetEffectiveGoalWeightKg();
            var currentTypedKg = ConvertWeightInputToKg(ParsePositiveWeightInput(_currentWeightText));
            _profile.GoalWeightKg = currentGoalKg;
            _profile.UnitSystem = next;
            SyncGoalWeightInput();
            _currentWeightText = currentTypedKg is double curKg ? FormatWeightInput(curKg) : string.Empty;
        }
    }

    private async Task SetThemeAsync(ThemeMode mode)
    {
        _profile.ThemeMode = mode;
        await ProfileRepo.SaveAsync(_profile);
        await ThemeService.ApplyThemeAsync(_profile.ThemeMode, _profile.ColorScheme);
    }

    private async Task SetColorSchemeAsync(ColorScheme scheme)
    {
        _profile.ColorScheme = scheme;
        await ProfileRepo.SaveAsync(_profile);
        await ThemeService.ApplyThemeAsync(_profile.ThemeMode, _profile.ColorScheme);
    }

    private async Task SetPinCalorieSummaryAsync(bool pin)
    {
        _profile.PinCalorieSummary = pin;
        await ProfileRepo.SaveAsync(_profile);
    }

    private async Task SetSummaryStyleAsync(CalorieSummaryStyle style)
    {
        _profile.SummaryStyle = style;
        await ProfileRepo.SaveAsync(_profile);
    }

    private async Task SetShowFoodsInBottomNavAsync(bool show)
    {
        _profile.ShowFoodsInBottomNav = show;
        await ProfileRepo.SaveAsync(_profile);
        LayoutState.SetShowFoodsInBottomNav(show);
    }

    private async Task SaveInitialCurrentWeightAsync(double weightKg)
    {
        var measurement = new BodyMeasurement
        {
            Id = Guid.NewGuid(),
            Date = DateOnly.FromDateTime(DateTime.Today),
            WeightKg = weightKg,
            HeightCm = _profile.HeightCm
        };
        await Diary.SaveBodyMeasurementAsync(measurement);
        _latestWeightKg = weightKg;
        _currentWeightText = string.Empty;
    }

    private async Task ApplyRecommendedCaloriesAsync(double recommended)
    {
        var rounded = Math.Round(recommended, 0);
        _profile.DailyCalorieGoal = rounded;
        SyncGoalWeightToProfile();
        await ProfileRepo.SaveAsync(_profile);

        if (_latestWeightKg is null && ConvertWeightInputToKg(ParsePositiveWeightInput(_currentWeightText)) is double enteredKg)
        {
            await SaveInitialCurrentWeightAsync(enteredKg);
        }

        _status = $"Applied {rounded:0} kcal/day and saved your goals!";
    }

    private async Task SaveProfileAsync()
    {
        SyncGoalWeightToProfile();
        await ProfileRepo.SaveAsync(_profile);
        _status = "Saved!";
    }

    private async Task SaveGoalSettingsAsync()
    {
        SyncGoalWeightToProfile();

        if (_latestWeightKg is null)
        {
            if (ConvertWeightInputToKg(ParsePositiveWeightInput(_currentWeightText)) is double enteredKg)
            {
                await ProfileRepo.SaveAsync(_profile);
                await SaveInitialCurrentWeightAsync(enteredKg);
                _status = "Saved your current weight and goal settings!";
                return;
            }

            if (_profile.GoalWeightKg.HasValue)
            {
                _popupWeightText = string.Empty;
                _currentWeightModalOpen = true;
                return;
            }
        }

        await ProfileRepo.SaveAsync(_profile);
        _status = "Saved!";
    }

    private async Task ConfirmPopupCurrentWeightAsync(bool applyCalories)
    {
        if (ConvertWeightInputToKg(ParsePositiveWeightInput(_popupWeightText)) is not double weightKg)
            return;

        SyncGoalWeightToProfile();
        AlignPaceIfBothWeightsKnown(weightKg, _profile.GoalWeightKg);

        double? appliedRec = null;
        if (applyCalories)
        {
            var tdee = GoalWeightCalculator.CalculateTdee(weightKg, _profile.HeightCm, _profile.AgeYears, _profile.BiologicalSex, _profile.ActivityLevel);
            if (tdee.HasValue)
            {
                appliedRec = Math.Round(GoalWeightCalculator.CalculateRecommendedDailyCalories(tdee.Value, _profile.WeeklyWeightChangeKg), 0);
                _profile.DailyCalorieGoal = appliedRec.Value;
            }
        }

        await ProfileRepo.SaveAsync(_profile);
        await SaveInitialCurrentWeightAsync(weightKg);
        _currentWeightModalOpen = false;
        _status = appliedRec.HasValue
            ? $"Applied {appliedRec.Value:0} kcal/day and saved your weight & goals!"
            : "Saved your current weight and goal settings!";
    }

    private async Task SkipCurrentWeightPopupAsync()
    {
        _currentWeightModalOpen = false;
        await SaveProfileAsync();
    }

    private async Task MoveSlotAsync(int index, int delta)
    {
        var target = index + delta;
        if (target < 0 || target >= _slots.Count) return;

        (_slots[index], _slots[target]) = (_slots[target], _slots[index]);
        for (var i = 0; i < _slots.Count; i++)
        {
            _slots[i].SortOrder = i;
            await SlotRepo.SaveAsync(_slots[i]);
        }
        _status = "Updated meal slot order.";
    }

    private void OpenAddSlotModal()
    {
        _editingSlotId = null;
        _newSlotName = string.Empty;
        _newSlotIcon = AppIcons.MealMain;
        _slotModalOpen = true;
    }

    private void OpenEditSlotModal(MealSlot slot)
    {
        _editingSlotId = slot.Id;
        _newSlotName = slot.Name;
        _newSlotIcon = AppIcon.NormalizeName(slot.Icon);
        _slotModalOpen = true;
    }

    private async Task SaveSlotModalAsync()
    {
        if (string.IsNullOrWhiteSpace(_newSlotName)) return;

        var icon = string.IsNullOrWhiteSpace(_newSlotIcon) ? AppIcons.MealMain : _newSlotIcon.Trim();

        if (_editingSlotId.HasValue)
        {
            var existing = _slots.FirstOrDefault(s => s.Id == _editingSlotId.Value);
            if (existing is not null)
            {
                existing.Name = _newSlotName.Trim();
                existing.Icon = icon;
                await SlotRepo.SaveAsync(existing);
                _status = $"Updated \"{existing.Name}\".";
            }
        }
        else
        {
            var nextOrder = _slots.Count > 0 ? _slots.Max(s => s.SortOrder) + 1 : 0;
            await SlotRepo.SaveAsync(new MealSlot
            {
                Id = Guid.NewGuid(),
                Name = _newSlotName.Trim(),
                Icon = icon,
                SortOrder = nextOrder
            });
            _status = "Added new meal time.";
        }

        _slotModalOpen = false;
        _editingSlotId = null;
        _newSlotName = string.Empty;
        await ReloadAsync();
    }

    private async Task SetWaterTrackingAsync(bool enabled)
    {
        if (enabled)
        {
            var all = await SlotRepo.GetAllAsync(includeArchived: true);
            var water = all.FirstOrDefault(s => s.IsWaterTracker);
            if (water is null)
            {
                var nextOrder = _slots.Count > 0 ? _slots.Max(s => s.SortOrder) + 1 : 0;
                await SlotRepo.SaveAsync(new MealSlot
                {
                    Id = MealSlot.WaterSlotId,
                    Name = "Water",
                    Icon = AppIcons.Water,
                    SortOrder = nextOrder,
                    IsArchived = false
                });
            }
            else if (water.IsArchived)
            {
                water.IsArchived = false;
                water.SortOrder = _slots.Count > 0 ? _slots.Max(s => s.SortOrder) + 1 : 0;
                await SlotRepo.SaveAsync(water);
            }
            _status = "Water tracking enabled.";
        }
        else
        {
            await SlotRepo.DeleteOrArchiveAsync(MealSlot.WaterSlotId);
            _status = "Water tracking hidden from Diary (past water logs preserved).";
        }

        await ReloadAsync();
    }

    private async Task ArchiveSlotAsync(Guid id)
    {
        await SlotRepo.DeleteOrArchiveAsync(id);
        _status = "Meal slot removed from active diary (past entries preserved).";
        await ReloadAsync();
    }

    private async Task ExportPersonalBackupAsync()
    {
        var bytes = await BackupService.ExportPersonalSqliteBytesAsync();
        var fileName = $"personal-{DateTime.Now:yyyyMMdd-HHmm}.sqlite";
        await FileDownload.DownloadBytesAsync(fileName, "application/x-sqlite3", bytes);
        _status = $"Exported private personal database {fileName} ({UnitConverter.FormatStorageSize(bytes.Length)}).";
    }

    private async Task ImportPersonalBackupAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        await using var stream = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        await BackupService.ImportPersonalSqliteBytesAsync(ms.ToArray());
        await ReloadAsync();
        await LoadDatabaseSizesAsync();
        _status = "Personal SQLite database restored successfully!";
    }

    private async Task ExportFoodsBackupAsync()
    {
        var bytes = await BackupService.ExportFoodsSqliteBytesAsync();
        var fileName = $"foods-{DateTime.Now:yyyyMMdd-HHmm}.sqlite";
        await FileDownload.DownloadBytesAsync(fileName, "application/x-sqlite3", bytes);
        _status = $"Exported shareable food catalog {fileName} ({UnitConverter.FormatStorageSize(bytes.Length)}).";
    }

    private async Task ImportFoodsBackupAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        await using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        await BackupService.ImportFoodsSqliteBytesAsync(ms.ToArray());
        await LoadDatabaseSizesAsync();
        _status = "Food catalog SQLite database restored successfully!";
    }
}

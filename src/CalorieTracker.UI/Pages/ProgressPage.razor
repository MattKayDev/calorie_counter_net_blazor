@page "/progress"
@using System.Globalization
@inject IUserProfileRepository ProfileRepo
@inject IBodyMeasurementRepository BodyRepo
@inject IFoodLogRepository LogRepo
@inject DiaryService Diary

<div class="ct-topbar">
    <div class="ct-topbar-row">
        <div class="ct-topbar-left">
            <a class="ct-cog-btn" href="settings" title="Settings" aria-label="Settings"><AppIcon Name="@AppIcons.Settings" Size="20" /></a>
            <div class="ct-brand">Body &amp; Progress</div>
        </div>
        <button class="ct-datebtn" style="padding:6px 8px; font-size:0.84rem;"
                @onclick="OpenLogModal">
            + Log Metrics
        </button>
    </div>
</div>

<div class="ct-page">
    @if (!string.IsNullOrWhiteSpace(_notice))
    {
        <div class="ct-alert ct-alert-success">@_notice</div>
    }

    <!-- Latest Summary Cards -->
    <div class="ct-grid-3">
        <div class="ct-card" style="text-align:center; padding:12px 8px;">
            <div class="ct-stat-lbl">Weight</div>
            <div class="ct-stat-val" style="font-size:1.08rem; margin-top:4px;">
                @UnitConverter.FormatWeight(_latest?.WeightKg, _profile.UnitSystem)
            </div>
            @if (_profile.GoalWeightKg is double gw)
            {
                <div class="ct-muted" style="font-size:0.68rem; margin-top:3px;">
                    Goal: @UnitConverter.FormatWeight(gw, _profile.UnitSystem)
                </div>
            }
        </div>
        <div class="ct-card" style="text-align:center; padding:12px 8px;">
            <div class="ct-stat-lbl">BMI</div>
            <div class="ct-stat-val" style="font-size:1.08rem; margin-top:4px;">
                @(_latest?.ComputedBmi?.ToString("0.0") ?? "—")
            </div>
            <div style="margin-top:4px;">
                <span class="ct-badge @BmiBadgeClass(_latest?.ComputedBmi)">
                    @BodyMetricsCalculator.GetBmiCategory(_latest?.ComputedBmi)
                </span>
            </div>
        </div>
        <div class="ct-card" style="text-align:center; padding:12px 8px;">
            <div class="ct-stat-lbl">Body Fat</div>
            <div class="ct-stat-val" style="font-size:1.08rem; margin-top:4px;">
                @(_latest?.EffectiveBodyFatPercent is double bf ? $"{bf:0.0}%" : "—")
            </div>
            <div class="ct-muted" style="font-size:0.68rem;">
                @(_latest?.ManualBodyFatPercent is not null ? "Manual / Scale" : _latest?.ComputedBodyFatPercent is not null ? "US Navy est." : "Add tape/scale")
            </div>
        </div>
    </div>

    <!-- Goal Weight & Target Date Forecast Card -->
    <div class="ct-card">
        <div class="ct-card-header">
            <h2 class="ct-card-title"><span style="color:var(--ct-green);"><AppIcon Name="@AppIcons.Target" Size="18" /></span> Goal Weight &amp; Forecast</h2>
            @if (_recommendedDailyKcal is double rec && Math.Abs(rec - _profile.DailyCalorieGoal) >= 25)
            {
                <button class="ct-btn ct-btn-soft ct-btn-sm" @onclick="() => ApplyRecommendedGoalAsync(rec)">
                    Use @rec.ToString("0") kcal
                </button>
            }
        </div>

        @if (_latest?.WeightKg is null || _profile.GoalWeightKg is null || _tdee is null)
        {
            <div class="ct-muted">
                Log your current <strong>Weight</strong> &amp; <strong>Height</strong> here, and set your <strong>Goal Weight</strong>, <strong>Age</strong>, and <strong>Activity Level</strong> in <strong>Settings</strong> to calculate your daily calorie target and projected goal date.
            </div>
        }
        else
        {
            var diffKg = _latest.WeightKg.Value - _profile.GoalWeightKg.Value;
            <div class="ct-grid-3" style="margin-bottom:12px;">
                <div style="background:var(--ct-surface-muted); border-radius:10px; padding:10px; text-align:center;">
                    <div class="ct-muted" style="font-size:0.7rem;">To Go</div>
                    <div style="font-weight:800; font-size:0.95rem;">
                        @(Math.Abs(diffKg) < 0.05 ? "Reached!" : $"{(diffKg > 0 ? "-" : "+")}{UnitConverter.FormatWeight(Math.Abs(diffKg), _profile.UnitSystem)}")
                    </div>
                </div>
                <div style="background:var(--ct-surface-muted); border-radius:10px; padding:10px; text-align:center;">
                    <div class="ct-muted" style="font-size:0.7rem;">Est. TDEE</div>
                    <div style="font-weight:800; font-size:0.95rem;">@_tdee.Value.ToString("0") kcal</div>
                </div>
                <div style="background:var(--ct-surface-muted); border-radius:10px; padding:10px; text-align:center;">
                    <div class="ct-muted" style="font-size:0.7rem;">Recommended</div>
                    <div style="font-weight:800; font-size:0.95rem; color:var(--ct-green-dark);">@(_recommendedDailyKcal?.ToString("0") ?? "—") kcal</div>
                </div>
            </div>

            @if (_plannedProjection is not null)
            {
                <div class="ct-entry-row" style="background:var(--ct-surface-muted); border-radius:12px; margin-bottom:8px;">
                    <div>
                        <div class="ct-entry-name">At your daily goal (@_profile.DailyCalorieGoal.ToString("0") kcal/day)</div>
                        <div class="ct-entry-meta">
                            @FormatProjectionText(_plannedProjection)
                        </div>
                    </div>
                    @if (_plannedProjection.EstimatedDate is DateOnly pd)
                    {
                        <span class="ct-badge ct-badge-green">@pd.ToString("dd MMM yyyy")</span>
                    }
                </div>
            }

            @if (_actualAvgKcal is double avgKcal && _actualProjection is not null)
            {
                <div class="ct-entry-row" style="background:var(--ct-surface-muted); border-radius:12px;">
                    <div>
                        <div class="ct-entry-name">At your actual tracked pace (@avgKcal.ToString("0") kcal/day avg)</div>
                        <div class="ct-entry-meta">
                            @FormatProjectionText(_actualProjection)
                        </div>
                    </div>
                    @if (_actualProjection.EstimatedDate is DateOnly ad)
                    {
                        <span class="ct-badge ct-badge-blue">@ad.ToString("dd MMM yyyy")</span>
                    }
                </div>
            }
            else
            {
                <div class="ct-muted" style="font-size:0.78rem;">
                    Log a few days of food in your Diary to compare your actual tracked pace against your target date.
                </div>
            }
        }
    </div>

    <!-- Weight Trend Line Chart -->
    @if (_weightPoints.Count >= 2)
    {
        <div class="ct-card">
            <div class="ct-card-header">
                <h2 class="ct-card-title">Weight Trend</h2>
                <span class="ct-muted">@_weightPoints.Count entries</span>
            </div>
            @RenderWeightTrendChart()
        </div>
    }

    <!-- Last 14 Days Calories Bar Chart -->
    <div class="ct-card">
        <div class="ct-card-header">
            <h2 class="ct-card-title">Last 14 Days Calories</h2>
            <span class="ct-muted">Goal: @_profile.DailyCalorieGoal.ToString("0")</span>
        </div>
        <div style="display:flex; align-items:flex-end; gap:4px; height:110px; padding-top:12px;">
            @foreach (var day in _last14Days)
            {
                var kcal = _calorieHistory.TryGetValue(day, out var v) ? v : 0;
                var maxRef = Math.Max(_profile.DailyCalorieGoal * 1.2, _calorieHistory.Values.DefaultIfEmpty(1).Max());
                var hPct = maxRef > 0 ? Math.Clamp(kcal / maxRef * 100.0, 2, 100) : 2;
                var barColor = kcal == 0 ? "var(--ct-track)" : kcal > _profile.DailyCalorieGoal ? "#ef4444" : "var(--ct-green)";

                <div style="flex:1; display:flex; flex-direction:column; align-items:center; height:100%; justify-content:flex-end;"
                     title="@day.ToString("dd MMM"): @kcal.ToString("0") kcal">
                    <div style="width:100%; max-width:20px; height:@hPct.ToString("0", CultureInfo.InvariantCulture)%; background:@barColor; border-radius:4px 4px 0 0;"></div>
                    <span style="font-size:0.62rem; color:var(--ct-text-muted); margin-top:4px;">@day.Day</span>
                </div>
            }
        </div>
    </div>

    <!-- Weight & Body Measurements History -->
    <div class="ct-card">
        <div class="ct-card-header">
            <h2 class="ct-card-title">Measurements Log</h2>
            <button class="ct-btn ct-btn-soft ct-btn-sm" @onclick="OpenLogModal">+ Add</button>
        </div>

        @if (_measurements.Count == 0)
        {
            <div class="ct-muted" style="text-align:center; padding:20px 0;">
                No measurements logged yet. Tap <strong>+ Log Metrics</strong> to track weight, BMI, and body fat %.
            </div>
        }
        else
        {
            <div style="display:flex; flex-direction:column; gap:8px;">
                @foreach (var m in _measurements)
                {
                    <div class="ct-entry-row" style="background:var(--ct-surface-muted); border-radius:12px;">
                        <div>
                            <div class="ct-entry-name">
                                @m.Date.ToString("dd MMM yyyy") • @UnitConverter.FormatWeight(m.WeightKg, _profile.UnitSystem)
                            </div>
                            <div class="ct-entry-meta">
                                BMI @(m.ComputedBmi?.ToString("0.0") ?? "—")
                                @if (m.EffectiveBodyFatPercent is double entryBf)
                                {
                                    <span> • BF @entryBf.ToString("0.0")% (@(m.ManualBodyFatPercent is not null ? "manual" : "US Navy"))</span>
                                }
                                @if (m.WaistCm is double w)
                                {
                                    <span> • Waist @UnitConverter.FormatLength(w, _profile.UnitSystem)</span>
                                }
                            </div>
                        </div>
                        <button class="ct-icon-btn" title="Delete" @onclick="() => DeleteMeasurementAsync(m.Id)"><AppIcon Name="@AppIcons.Delete" Size="16" /></button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (_modalOpen)
{
    <div class="ct-modal-backdrop" @onclick="() => _modalOpen = false">
        <div class="ct-modal" @onclick:stopPropagation="true">
            <div class="ct-modal-head">
                <strong>Log Body Measurements</strong>
                <button class="ct-icon-btn" @onclick="() => _modalOpen = false"><AppIcon Name="@AppIcons.Close" Size="18" /></button>
            </div>
            <div class="ct-modal-body">
                @if (_profile.BiologicalSex == BiologicalSex.Unspecified)
                {
                    <div class="ct-alert ct-alert-warn" style="margin-bottom:10px;">
                        Tip: Set your Biological Sex in <strong>Settings</strong> to enable automatic US Navy Body Fat % estimation.
                    </div>
                }

                <div class="ct-field">
                    <label class="ct-label">Date</label>
                    <input class="ct-input" type="date" @bind="_entryDate" />
                </div>

                <div class="ct-grid-2">
                    <div class="ct-field">
                        <label class="ct-label">Weight (@UnitConverter.WeightUnitLabel(_profile.UnitSystem))</label>
                        <input class="ct-input" type="number" step="0.1" @bind="_weightInput" />
                    </div>
                    <div class="ct-field">
                        <label class="ct-label">Height (@UnitConverter.LengthUnitLabel(_profile.UnitSystem))</label>
                        <input class="ct-input" type="number" step="0.1" @bind="_heightInput" />
                    </div>
                </div>

                <div class="ct-field">
                    <label class="ct-label">Manual Body Fat % (smart scale, optional)</label>
                    <input class="ct-input" type="number" step="0.1" placeholder="Optional" @bind="_manualBfInput" />
                </div>

                <div style="font-weight:700; font-size:0.84rem; margin:8px 0 6px;">
                    Tape Measurements (@UnitConverter.LengthUnitLabel(_profile.UnitSystem)) — for US Navy Body Fat %
                </div>
                <div class="ct-grid-3">
                    <div class="ct-field">
                        <label class="ct-label">Neck</label>
                        <input class="ct-input" type="number" step="0.1" @bind="_neckInput" />
                    </div>
                    <div class="ct-field">
                        <label class="ct-label">Waist</label>
                        <input class="ct-input" type="number" step="0.1" @bind="_waistInput" />
                    </div>
                    <div class="ct-field">
                        <label class="ct-label">Hip (F)</label>
                        <input class="ct-input" type="number" step="0.1" @bind="_hipInput" />
                    </div>
                </div>

                <button class="ct-btn ct-btn-primary" style="width:100%; margin-top:8px;" @onclick="SaveMeasurementAsync">
                    Save Measurement
                </button>
            </div>
        </div>
    </div>
}

@code {
    private UserProfile _profile = new();
    private List<BodyMeasurement> _measurements = new();
    private List<(DateOnly Date, double WeightKg)> _weightPoints = new();
    private BodyMeasurement? _latest;
    private Dictionary<DateOnly, double> _calorieHistory = new();
    private List<DateOnly> _last14Days = new();

    private double? _tdee;
    private double? _recommendedDailyKcal;
    private double? _actualAvgKcal;
    private GoalProjectionResult? _plannedProjection;
    private GoalProjectionResult? _actualProjection;
    private string? _notice;

    private bool _modalOpen;
    private DateOnly _entryDate = DateOnly.FromDateTime(DateTime.Today);
    private double? _weightInput;
    private double? _heightInput;
    private double? _neckInput;
    private double? _waistInput;
    private double? _hipInput;
    private double? _manualBfInput;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _profile = await ProfileRepo.GetOrCreateAsync();
        _measurements = await BodyRepo.GetAllAsync();
        _latest = _measurements.FirstOrDefault();

        _weightPoints = _measurements
            .Where(m => m.WeightKg.HasValue)
            .OrderBy(m => m.Date)
            .Select(m => (m.Date, m.WeightKg!.Value))
            .ToList();

        var today = DateOnly.FromDateTime(DateTime.Today);
        var start = today.AddDays(-13);
        _last14Days = Enumerable.Range(0, 14).Select(i => start.AddDays(i)).ToList();
        _calorieHistory = await LogRepo.GetDailyCalorieTotalsAsync(start, today);

        // Compute TDEE, recommended daily calories, and planned vs actual goal projections
        var height = _latest?.HeightCm ?? _profile.HeightCm;
        _tdee = GoalWeightCalculator.CalculateTdee(_latest?.WeightKg, height, _profile.AgeYears, _profile.BiologicalSex, _profile.ActivityLevel);
        _recommendedDailyKcal = _tdee.HasValue
            ? GoalWeightCalculator.CalculateRecommendedDailyCalories(_tdee.Value, _profile.WeeklyWeightChangeKg)
            : null;

        var trackedDays = _calorieHistory.Values.Where(v => v > 0).ToList();
        _actualAvgKcal = trackedDays.Count > 0 ? Math.Round(trackedDays.Average(), 0) : null;

        if (_latest?.WeightKg is double cw && _profile.GoalWeightKg is double gw && _tdee is double tdee)
        {
            _plannedProjection = GoalWeightCalculator.ProjectGoalDate(today, cw, gw, tdee, _profile.DailyCalorieGoal);
            _actualProjection = _actualAvgKcal is double avg
                ? GoalWeightCalculator.ProjectGoalDate(today, cw, gw, tdee, avg)
                : null;
        }
        else
        {
            _plannedProjection = null;
            _actualProjection = null;
        }
    }

    private async Task ApplyRecommendedGoalAsync(double recommended)
    {
        _profile.DailyCalorieGoal = recommended;
        await ProfileRepo.SaveAsync(_profile);
        _notice = $"Updated your Daily Calorie Goal to {recommended:0} kcal!";
        await ReloadAsync();
    }

    private static string FormatProjectionText(GoalProjectionResult proj)
    {
        if (proj.AlreadyReached) return "You've reached your goal weight! 🎉";
        if (!proj.IsMovingTowardGoal)
            return $"Currently moving away from goal ({proj.ProjectedWeeklyChangeKg:+0.##;-0.##;0} kg/wk). Adjust daily calories.";
        var weeks = Math.Round((proj.DaysToGoal ?? 0) / 7.0, 1);
        return $"~{proj.DaysToGoal} days (~{weeks:0.#} wks) • {proj.ProjectedWeeklyChangeKg:+0.##;-0.##;0} kg/wk";
    }

    private RenderFragment RenderWeightTrendChart() => __builder =>
    {
        const double width = 320;
        const double height = 130;
        const double padX = 16;
        const double padY = 16;

        var allVals = _weightPoints.Select(p => p.WeightKg).ToList();
        if (_profile.GoalWeightKg is double gw) allVals.Add(gw);
        var minW = allVals.Min() - 1.0;
        var maxW = allVals.Max() + 1.0;
        var span = Math.Max(0.5, maxW - minW);

        double MapX(int idx) => padX + (width - 2 * padX) * idx / Math.Max(1, _weightPoints.Count - 1);
        double MapY(double w) => height - padY - (height - 2 * padY) * ((w - minW) / span);

        var pointsStr = string.Join(" ", _weightPoints.Select((p, i) =>
            $"{MapX(i).ToString("0.0", CultureInfo.InvariantCulture)},{MapY(p.WeightKg).ToString("0.0", CultureInfo.InvariantCulture)}"));

        <svg viewBox="0 0 320 130" style="width:100%; height:130px; overflow:visible;">
            @if (_profile.GoalWeightKg is double goalW)
            {
                var gy = MapY(goalW).ToString("0.0", CultureInfo.InvariantCulture);
                <line x1="@padX" y1="@gy" x2="@(width - padX)" y2="@gy"
                      stroke="#16a34a" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.7" />
                @:<text x="@(width - padX)" y="@(MapY(goalW) - 4)" text-anchor="end" font-size="9" fill="#16a34a">Goal</text>
            }
            <polyline fill="none" stroke="var(--ct-green)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" points="@pointsStr" />
            @for (var i = 0; i < _weightPoints.Count; i++)
            {
                var cx = MapX(i).ToString("0.0", CultureInfo.InvariantCulture);
                var cy = MapY(_weightPoints[i].WeightKg).ToString("0.0", CultureInfo.InvariantCulture);
                <circle cx="@cx" cy="@cy" r="3.5" fill="var(--ct-green)" />
            }
        </svg>
        <div style="display:flex; justify-content:space-between; font-size:0.72rem; color:var(--ct-text-muted); margin-top:2px;">
            <span>@_weightPoints.First().Date.ToString("dd MMM") (@UnitConverter.FormatWeight(_weightPoints.First().WeightKg, _profile.UnitSystem))</span>
            <span>@_weightPoints.Last().Date.ToString("dd MMM") (@UnitConverter.FormatWeight(_weightPoints.Last().WeightKg, _profile.UnitSystem))</span>
        </div>
    };

    private void OpenLogModal()
    {
        _entryDate = DateOnly.FromDateTime(DateTime.Today);
        var isMetric = _profile.UnitSystem == UnitSystem.Metric;
        _weightInput = _latest?.WeightKg is double w ? (isMetric ? w : UnitConverter.KgToLbs(w)) : null;
        var hCm = _latest?.HeightCm ?? _profile.HeightCm;
        _heightInput = hCm is double h ? (isMetric ? h : UnitConverter.CmToInches(h)) : null;
        _neckInput = null;
        _waistInput = null;
        _hipInput = null;
        _manualBfInput = null;
        _modalOpen = true;
    }

    private async Task SaveMeasurementAsync()
    {
        var isMetric = _profile.UnitSystem == UnitSystem.Metric;
        var m = new BodyMeasurement
        {
            Id = Guid.NewGuid(),
            Date = _entryDate,
            WeightKg = _weightInput.HasValue ? (isMetric ? _weightInput : UnitConverter.LbsToKg(_weightInput.Value)) : null,
            HeightCm = _heightInput.HasValue ? (isMetric ? _heightInput : UnitConverter.InchesToCm(_heightInput.Value)) : null,
            NeckCm = _neckInput.HasValue ? (isMetric ? _neckInput : UnitConverter.InchesToCm(_neckInput.Value)) : null,
            WaistCm = _waistInput.HasValue ? (isMetric ? _waistInput : UnitConverter.InchesToCm(_waistInput.Value)) : null,
            HipCm = _hipInput.HasValue ? (isMetric ? _hipInput : UnitConverter.InchesToCm(_hipInput.Value)) : null,
            ManualBodyFatPercent = _manualBfInput
        };

        await Diary.SaveBodyMeasurementAsync(m);
        _modalOpen = false;
        await ReloadAsync();
    }

    private async Task DeleteMeasurementAsync(Guid id)
    {
        await BodyRepo.SoftDeleteAsync(id);
        await ReloadAsync();
    }

    private static string BmiBadgeClass(double? bmi) => bmi switch
    {
        null => "ct-badge-gray",
        < 18.5 => "ct-badge-blue",
        < 25.0 => "ct-badge-green",
        < 30.0 => "ct-badge-amber",
        _ => "ct-badge-red"
    };
}
